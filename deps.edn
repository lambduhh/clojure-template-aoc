{:paths ["src"]

 :deps
 {org.clojure/clojure             {:mvn/version "1.12.6"}
  ;; "a plus-one for the standard library"
  org.clojure/data.json           {:mvn/version "2.5.2"}
  org.clojure/data.csv            {:mvn/version "1.1.1"}
  org.clojure/math.combinatorics  {:mvn/version "0.3.2"}
  org.clojure/math.numeric-tower  {:mvn/version "0.1.1"}
  org.clojure/data.priority-map   {:mvn/version "1.2.1"}
  org.clojure/core.match          {:mvn/version "1.1.1"}
  dev.weavejester/medley          {:mvn/version "1.10.0"}
  com.datomic/local               {:mvn/version "1.0.301"}}

 :aliases
 {;; clojure -X:test   (or: clojure -M:test, or: bb test)
  :test  {:extra-paths ["test"]
          :extra-deps  {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                        org.clojure/test.check {:mvn/version "1.1.3"}}
          :main-opts   ["-m" "cognitect.test-runner"]
          :exec-fn     cognitect.test-runner.api/test}

  ;; Opt in to the Clojure 1.13 alpha for feature sessions:
  ;; clojure -M:1.13:nrepl
  :1.13  {:override-deps {org.clojure/clojure {:mvn/version "1.13.0-alpha11"}}}

  ;; Terminal REPL with an nREPL server for editors to connect to.
  ;; (Calva's jack-in doesn't need this.)
  :nrepl {:extra-paths ["test"]
          :extra-deps  {nrepl/nrepl {:mvn/version "1.8.0"}}
          :main-opts   ["-m" "nrepl.cmdline" "--interactive"]}

  ;; Linter: clojure -M:lint   (or: bb lint)
  :lint  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.10.26"}}
          :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test"]}

  ;; Data inspector in the browser. Add to your REPL: clojure -M:portal:nrepl
  :portal {:extra-deps {djblue/portal {:mvn/version "0.68.1"}}}

  ;; Benchmarking: clojure -M:bench:nrepl, then (criterium.core/quick-bench ...)
  :bench {:extra-deps {criterium/criterium {:mvn/version "0.4.6"}}}

  ;; Notebooks: clojure -M:clerk:nrepl, then (nextjournal.clerk/serve! {:browse true})
  :clerk {:extra-deps {io.github.nextjournal/clerk {:mvn/version "0.18.1158"}}}}}
