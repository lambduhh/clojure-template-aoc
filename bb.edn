{:tasks
 {test    {:doc  "Run all tests"
           :task (clojure "-X:test")}
  lint    {:doc  "Lint src/ and test/ with clj-kondo and Splint"
           :task (do (clojure "-M:lint")
                     (clojure "-M:splint"))}
  sins    {:doc      "Check the lint config still catches each sin in lint-fixtures/"
           :requires ([babashka.process :as p]
                      [clojure.string :as str])
           :task     (let [run      (fn [& args]
                                      (:out (apply p/shell {:out :string :err :string :continue true}
                                                   "clojure" args)))
                           kondo    (run "-M:lint" "--lint" "lint-fixtures")
                           splint   (run "-M:splint" "lint-fixtures")
                           ;; [sin, tool output, text the warning must contain]
                           expected [[1  splint "[lint/dorun-map]"]
                                     [1  kondo  "Unused value"]
                                     [4  kondo  "read-string can execute code"]
                                     [5  kondo  "Missing else branch"]
                                     [5  splint "[lint/if-else-nil]"]
                                     [6  kondo  "inline def"]
                                     [9  splint "[lint/fn-wrapper]"]
                                     [10 kondo  "use alias or :refer"]
                                     [10 kondo  "Shadowed var: clojure.core/map"]
                                     [11 splint "[style/prefer-clj-string]"]]
                           missing  (remove (fn [[_ out text]] (str/includes? out text)) expected)]
                       (doseq [[sin _ text] expected]
                         (println (if (some #{[sin text]} (map (fn [[s _ t]] [s t]) missing)) "MISSED" "caught")
                                  (str "sin " sin ":") text))
                       (when (seq missing)
                         (println (count missing) "expected warning(s) missing: the lint config no longer catches every sin.")
                         (System/exit 1)))}
  repl    {:doc  "Start a REPL with an nREPL server"
           :override-builtin true
           :task (clojure "-M:nrepl")}
  new-day {:doc      "Create src/aoc/dayNN.clj and its test, e.g. bb new-day 1"
           :requires ([clojure.string :as str]
                      [babashka.fs :as fs])
           :task     (let [n    (or (some-> *command-line-args* first parse-long)
                                    (throw (ex-info "Usage: bb new-day <day-number>" {})))
                           nn   (format "%02d" n)
                           src  (str "src/aoc/day" nn ".clj")
                           test (str "test/aoc/day" nn "_test.clj")]
                       (doseq [f [src test]]
                         (when (fs/exists? f)
                           (throw (ex-info (str f " already exists") {:file f}))))
                       (spit src (str/join "\n"
                                  [(str "(ns aoc.day" nn)
                                   "  (:require [aoc.input :as input]"
                                   "            [clojure.string :as str]))"
                                   ""
                                   "(def example \"\")"
                                   ""
                                   "(defn parse [s]"
                                   "  (str/split-lines s))"
                                   ""
                                   "(defn part-1 [s])"
                                   ""
                                   "(defn part-2 [s])"
                                   ""
                                   "(comment"
                                   "  (parse example)"
                                   "  (part-1 example)"
                                   (str "  (part-1 (input/slurp-day " n "))")
                                   "  )"
                                   ""]))
                       (spit test (str/join "\n"
                                   [(str "(ns aoc.day" nn "-test")
                                    (str "  (:require [aoc.day" nn " :as day]")
                                    "            [clojure.test :refer [deftest is]]))"
                                    ""
                                    "(deftest example"
                                    "  ;; Replace :answer-from-the-puzzle with the example's answer from the puzzle text."
                                    "  (is (= :answer-from-the-puzzle (day/part-1 day/example))))"
                                    ""]))
                       (println "Created" src "and" test))}}}
